@model HomeVm
@{
    ViewData["Title"] = "Home Page";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>

<style>
    * {
    font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
    background: linear-gradient(135deg, #e8f4fd 0%, #f0f4f8 50%, #fef9f0 100%);
    min-height: 100vh;
    margin: 0;
    padding: 0;
    }

    .page-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    @@keyframes fadeInUp {
    from {
    opacity: 0;
    transform: translateY(30px);
    }

    to {
    opacity: 1;
    transform: translateY(0);
    }
    }

    @@keyframes scaleIn {
    from {
    opacity: 0;
    transform: scale(0.95);
    }

    to {
    opacity: 1;
    transform: scale(1);
    }
    }

    @@keyframes slideInRight {
    from {
    opacity: 0;
    transform: translateX(40px);
    }

    to {
    opacity: 1;
    transform: translateX(0);
    }
    }

    @@keyframes slideInLeft {
    from {
    opacity: 0;
    transform: translateX(-40px);
    }

    to {
    opacity: 1;
    transform: translateX(0);
    }
    }

    @@keyframes float {
    0%, 100% {
    transform: translateY(0px);
    }

    50% {
    transform: translateY(-10px);
    }
    }

    @@keyframes shimmer {
    0% {
    background-position: -200% 0;
    }

    100% {
    background-position: 200% 0;
    }
    }

    .hero-card {
    background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
    border-radius: 24px;
    padding: 48px 40px;
    text-align: center;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
    animation: slideInRight 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .hero-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    }

    .hero-card::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -40px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    }

    .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    }

    .hero-card h1 {
    font-size: 36px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.2;
    }

    .hero-card p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 auto 32px;
    max-width: 420px;
    line-height: 1.6;
    }

    .hero-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
    }

    .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: #4f46e5;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 13px 28px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    }

    .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
    }

    .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    padding: 13px 28px;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    backdrop-filter: blur(4px);
    }

    .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
    }

    .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 28px;
    }

    .stat-card {
    background: #fff;
    border: 1.5px solid #f3f4f6;
    border-radius: 16px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: all 0.2s;
    animation: scaleIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    border-color: #e5e7eb;
    }

    .stat-card:nth-child(1) {
    animation-delay: 0.1s;
    }

    .stat-card:nth-child(2) {
    animation-delay: 0.2s;
    }

    .stat-card:nth-child(3) {
    animation-delay: 0.3s;
    }

    .stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    }

    .stat-num {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 4px;
    }

    .stat-lbl {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    }

    .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-bottom: 28px;
    }

    .feat-card {
    background: #fff;
    border: 1.5px solid #f3f4f6;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    transition: all 0.2s;
    cursor: pointer;
    text-decoration: none;
    display: block;
    animation: scaleIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .feat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    border-color: #e5e7eb;
    }

    .feat-card:nth-child(1) {
    animation-delay: 0.15s;
    }

    .feat-card:nth-child(2) {
    animation-delay: 0.25s;
    }

    .feat-card:nth-child(3) {
    animation-delay: 0.35s;
    }

    .feat-card:nth-child(4) {
    animation-delay: 0.45s;
    }

    .feat-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    }

    .feat-card h3 {
    font-size: 15px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 6px;
    }

    .feat-card p {
    font-size: 13px;
    color: #6b7280;
    margin: 0 0 14px;
    line-height: 1.5;
    }

    .feat-link {
    font-size: 12px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    }

    .tips {
    background: #fff;
    border: 1.5px solid #f3f4f6;
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 28px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
    animation: slideInLeft 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.15s;
    }

    .tips-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9ca3af;
    margin: 0 0 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    }

    .tips-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #f3f4f6;
    }

    .tip-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #f9fafb;
    }

    .tip-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    }

    .tip-dot {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
    margin-top: 1px;
    }

    .tip-item p {
    font-size: 13px;
    color: #374151;
    margin: 0;
    line-height: 1.5;
    }

    .tip-item span {
    font-weight: 600;
    color: #111827;
    }

    .footer-cta {
    background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 100%);
    border: 1.5px solid #e5e7eb;
    border-radius: 16px;
    padding: 28px 32px;
    text-align: center;
    animation: scaleIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.3s;
    }

    .footer-cta h3 {
    font-size: 18px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 8px;
    }

    .footer-cta p {
    font-size: 13px;
    color: #6b7280;
    margin: 0 0 20px;
    }

    .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #3b82f6, #6366f1);
    color: #fff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    padding: 13px 32px;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);
    }

    .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(59, 130, 246, 0.4);
    }

    .shimmer-text {
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.8) 25%, #fff 50%, rgba(255,255,255,0.9) 75%, #fff 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 3s linear infinite;
    }

    @@media (max-width: 768px) {
    .page-container {
    padding: 24px 16px 60px;
    }

    .hero-card {
    padding: 32px 24px;
    }

    .hero-card h1 {
    font-size: 28px;
    }

    .features {
    grid-template-columns: 1fr;
    }

    .stats-row {
    gap: 10px;
    }

    .stat-card {
    padding: 14px;
    }

    .stat-num {
    font-size: 20px;
    }
    }
</style>

<div class="page-container">
    <div class="hero-card">
        <div class="hero-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Your personal task manager
        </div>
        <h1>Stay focused,<br>get things done.</h1>
        <p>Organize your day, track your progress, and never lose track of what matters most — all in one place.</p>
        <div class="hero-btns">
            <a asp-action="Index" asp-controller="Category" class="btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Get started
            </a>
            <a asp-action="Index" asp-controller="Category" class="btn-ghost">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
                View my categories
            </a>
            <a asp-action="GetAll" asp-controller="ToDoItem" class="btn-ghost">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                View all tasks
            </a>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon" style="background:#eff6ff;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                </div>
                <div class="stat-num" style="color:#3b82f6;">@Model.TotalTasks</div>
                <div class="stat-lbl" style="color:#93c5fd;">Total tasks</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#f0fdf4;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <div class="stat-num" style="color:#10b981;">@Model.CompletedTasks</div>
                <div class="stat-lbl" style="color:#6ee7b7;">Completed</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:#fff7ed;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                </div>
                <div class="stat-num" style="color:#f59e0b;">@Model.PendingTasks</div>
                <div class="stat-lbl" style="color:#fcd34d;">Pending</div>
            </div>
        </div>
    }

    <div class="features">
        <a asp-action="Create" asp-controller="Category" class="feat-card">
            <div class="feat-icon" style="background:linear-gradient(135deg,#eff6ff,#eef2ff);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </div>
            <h3>Create a Category</h3>
            <p>Organize your tasks by creating categories like Work, Personal, or Shopping.</p>
            <div class="feat-link" style="color:#4f46e5;">
                Create now
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </a>

        <a asp-action="Index" asp-controller="Category" class="feat-card">
            <div class="feat-icon" style="background:linear-gradient(135deg,#f0fdf4,#ecfdf5);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="8" y1="6" x2="21" y2="6"></line>
                    <line x1="8" y1="12" x2="21" y2="12"></line>
                    <line x1="8" y1="18" x2="21" y2="18"></line>
                    <line x1="3" y1="6" x2="3.01" y2="6"></line>
                    <line x1="3" y1="12" x2="3.01" y2="12"></line>
                    <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
            </div>
            <h3>View My Categories</h3>
            <p>Browse all your categories, open any one, and manage the tasks inside it.</p>
            <div class="feat-link" style="color:#10b981;">
                See categories
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </div>
        </a>

        <div class="feat-card">
            <div class="feat-icon" style="background:linear-gradient(135deg,#fff7ed,#fffbeb);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
            </div>
            <h3>Set Priorities</h3>
            <p>Mark tasks as High, Medium, or Low priority and focus your energy on what matters most.</p>
        </div>

        <div class="feat-card">
            <div class="feat-icon" style="background:linear-gradient(135deg,#fdf2f8,#fce7f3);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <h3>Track Progress</h3>
            <p>Mark tasks as completed when you're done. Watch your productivity grow over time.</p>
        </div>
    </div>

    <div class="tips">
        <div class="tips-title">Quick tips to get started</div>
        <div class="tip-item">
            <div class="tip-dot" style="background:#eff6ff; color:#3b82f6;">1</div>
            <p><span>Open your categories</span> — You already have a "General" category ready. Click it to go inside.</p>
        </div>
        <div class="tip-item">
            <div class="tip-dot" style="background:#f0fdf4; color:#10b981;">2</div>
            <p><span>Create a task</span> — Inside any category, hit "New Task", give it a title, and set its priority.</p>
        </div>
        <div class="tip-item">
            <div class="tip-dot" style="background:#fff7ed; color:#f59e0b;">3</div>
            <p><span>Organize with categories</span> — Create new categories like Work or Personal to keep things tidy.</p>
        </div>
        <div class="tip-item">
            <div class="tip-dot" style="background:#fdf2f8; color:#ec4899;">4</div>
            <p><span>Track your progress</span> — Mark tasks as completed and watch your productivity grow over time.</p>
        </div>
    </div>

    <div class="footer-cta">
        <h3>Ready to be productive? 🚀</h3>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <p>Your categories are waiting. Open one and start adding tasks.</p>
            <a asp-action="Index" asp-controller="Category" class="btn-cta">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 7h-4.18A3 3 0 0 0 16 5.18V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v1.18A3 3 0 0 0 8.18 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"></path>
                </svg>
                Go to my categories
            </a>
        }
        else
        {
            <p>Create a free account and start organizing your tasks today.</p>
            <a asp-action="Index" asp-controller="Account" class="btn-cta">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
                Create a free account
            </a>
        }
    </div>
</div>