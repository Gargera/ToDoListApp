<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToDoListApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ToDoListApp.PL.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        *, body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .app-nav {
        background: #ffffff;
        border-bottom: 1px solid #f3f4f6;
        box-shadow: 0 1px 12px rgba(0,0,0,0.06);
        padding: 0 24px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
        }

        .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        }

        .nav-brand-icon {
        width: 34px;
        height: 34px;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        }

        .nav-brand-text {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.01em;
        }

        .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .btn-nav-ghost {
        padding: 8px 18px;
        border-radius: 9px;
        border: 1.5px solid #e5e7eb;
        background: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
        cursor: pointer;
        }

        .btn-nav-ghost:hover {
        border-color: #d1d5db;
        background: #f9fafb;
        color: #111827;
        text-decoration: none;
        }

        .btn-nav-primary {
        padding: 8px 18px;
        border-radius: 9px;
        border: none;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: 0 3px 10px rgba(59,130,246,0.3);
        cursor: pointer;
        }

        .btn-nav-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 16px rgba(59,130,246,0.4);
        color: #fff;
        text-decoration: none;
        }

        .btn-nav-primary:active {
        transform: translateY(0);
        }

        .page-content {
        min-height: calc(100vh - 62px - 58px);
        }

        .app-footer {
        height: 58px;
        background: #fff;
        border-top: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        }

        .footer-text {
        font-size: 12px;
        color: #9ca3af;
        }

        .footer-brand {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        }

        .footer-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: #d1d5db;
        }

        .nav-links {
        display: flex;
        align-items: center;
        gap: 4px;
        }

        .btn-nav-link {
        padding: 7px 14px;
        border-radius: 8px;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
        cursor: pointer;
        }

        .btn-nav-link:hover {
        background: #f3f4f6;
        color: #111827;
        text-decoration: none;
        }

        @@media (max-width: 480px) {
        .btn-nav-ghost span, .btn-nav-primary span {
        display: none;
        }

        .app-nav {
        padding: 0 16px;
        }
        }

        /* ── Sign Out Modal ── */
        .signout-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        }

        .signout-overlay.open {
        opacity: 1;
        pointer-events: all;
        }

        .signout-modal {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.14);
        width: 100%;
        max-width: 380px;
        overflow: hidden;
        transform: translateY(12px) scale(0.97);
        transition: transform 0.25s cubic-bezier(.16,1,.3,1);
        }

        .signout-overlay.open .signout-modal {
        transform: translateY(0) scale(1);
        }

        .signout-modal-header {
        background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
        padding: 28px 28px 36px;
        text-align: center;
        position: relative;
        }

        .signout-modal-header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        right: 0;
        height: 20px;
        background: #fff;
        border-radius: 20px 20px 0 0;
        }

        .signout-modal-icon {
        width: 52px;
        height: 52px;
        background: rgba(255,255,255,0.2);
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        }

        .signout-modal-body {
        padding: 8px 28px 28px;
        text-align: center;
        }

        .signout-modal-title {
        font-size: 18px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 8px;
        }

        .signout-modal-desc {
        font-size: 13px;
        color: #6b7280;
        margin: 0 0 24px;
        line-height: 1.55;
        }

        .signout-modal-actions {
        display: flex;
        gap: 10px;
        }

        .btn-cancel {
        flex: 1;
        padding: 11px;
        border-radius: 10px;
        border: 1.5px solid #e5e7eb;
        background: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        cursor: pointer;
        transition: all 0.18s;
        }

        .btn-cancel:hover {
        background: #f9fafb;
        border-color: #d1d5db;
        color: #111827;
        }

        .btn-confirm-signout {
        flex: 1;
        padding: 11px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #ef4444, #f97316);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 3px 10px rgba(239,68,68,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        }

        .btn-confirm-signout:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 16px rgba(239,68,68,0.4);
        }

        .btn-confirm-signout:active {
        transform: translateY(0);
        }
    </style>
</head>

<body style="background: linear-gradient(135deg, #e8f4fd 0%, #f0f4f8 50%, #fef9f0 100%); min-height: 100vh;">

    <nav class="app-nav">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">
            <div class="nav-brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
            </div>
            <span class="nav-brand-text">ToDoListApp</span>
        </a>

        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index" class="btn-nav-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                Home
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Category" asp-action="Index" class="btn-nav-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                    Categories
                </a>
                <a asp-controller="ToDoItem" asp-action="GetAll" class="btn-nav-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                    Tasks
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Users" class="btn-nav-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        Users
                    </a>
                }
            }
        </div>

        <div class="nav-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="LogOut" method="post" id="signOutForm" style="margin:0;">
                    @Html.AntiForgeryToken()
                </form>

                <button type="button" class="btn-nav-ghost" onclick="openSignOutModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                    <span>Sign Out</span>
                </button>
            }
            else
            {
                <a asp-controller="Account" asp-action="LogIn" class="btn-nav-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                        <polyline points="10 17 15 12 10 7"></polyline>
                        <line x1="15" y1="12" x2="3" y2="12"></line>
                    </svg>
                    <span>Sign In</span>
                </a>
                <a asp-controller="Account" asp-action="Index" class="btn-nav-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Create Account</span>
                </a>
            }
        </div>
    </nav>

    <div class="signout-overlay" id="signOutOverlay" onclick="handleOverlayClick(event)">
        <div class="signout-modal" role="dialog" aria-modal="true" aria-labelledby="signOutTitle">

            <div class="signout-modal-header">
                <div class="signout-modal-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </div>
            </div>

            <div class="signout-modal-body">
                <h2 class="signout-modal-title" id="signOutTitle">Sign Out?</h2>
                <p class="signout-modal-desc">
                    Are you sure you want to sign out?<br>You'll need to sign in again to access your tasks.
                </p>
                <div class="signout-modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeSignOutModal()">
                        Cancel
                    </button>
                    <button type="button" class="btn-confirm-signout" onclick="confirmSignOut()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        Yes, Sign Out
                    </button>
                </div>
            </div>

        </div>
    </div>

    <div class="container-fluid px-0">
        <main role="main" class="pb-3 page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="footer-dot"></div>
        <span class="footer-brand">ToDoListApp</span>
        <div class="footer-dot"></div>
        <span class="footer-text">&copy; 2026 All rights reserved</span>
        <div class="footer-dot"></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function openSignOutModal() {
        document.getElementById('signOutOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
        }

        function closeSignOutModal() {
        document.getElementById('signOutOverlay').classList.remove('open');
        document.body.style.overflow = '';
        }

        function confirmSignOut() {
        document.getElementById('signOutForm').submit();
        }

        function handleOverlayClick(e) {
        if (e.target === document.getElementById('signOutOverlay')) {
        closeSignOutModal();
        }
        }

        document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSignOutModal();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
