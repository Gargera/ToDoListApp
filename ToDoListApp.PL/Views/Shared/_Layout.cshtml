<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToDoListApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ToDoListApp.PL.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        *, body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .app-nav {
        background: #ffffff;
        border-bottom: 1px solid #f3f4f6;
        box-shadow: 0 1px 12px rgba(0,0,0,0.06);
        padding: 0 24px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
        }

        .nav-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        }
        .nav-brand-icon {
        width: 34px; height: 34px;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        }
        .nav-brand-text {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        letter-spacing: -0.01em;
        }

        .nav-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        }

        .btn-nav-ghost {
        padding: 8px 18px;
        border-radius: 9px;
        border: 1.5px solid #e5e7eb;
        background: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s;
        cursor: pointer;
        }
        .btn-nav-ghost:hover {
        border-color: #d1d5db;
        background: #f9fafb;
        color: #111827;
        text-decoration: none;
        }

        .btn-nav-primary {
        padding: 8px 18px;
        border-radius: 9px;
        border: none;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: 0 3px 10px rgba(59,130,246,0.3);
        cursor: pointer;
        }
        .btn-nav-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 5px 16px rgba(59,130,246,0.4);
        color: #fff;
        text-decoration: none;
        }
        .btn-nav-primary:active { transform: translateY(0); }

        .page-content {
        min-height: calc(100vh - 62px - 58px);
        }

        .app-footer {
        height: 58px;
        background: #fff;
        border-top: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        }
        .footer-text {
        font-size: 12px;
        color: #9ca3af;
        }
        .footer-brand {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        }
        .footer-dot {
        width: 3px; height: 3px;
        border-radius: 50%;
        background: #d1d5db;
        }

        @@media (max-width: 480px) {
        .btn-nav-ghost span, .btn-nav-primary span { display: none; }
        .app-nav { padding: 0 16px; }
        }
    </style>
</head>

<body style="background: linear-gradient(135deg, #e8f4fd 0%, #f0f4f8 50%, #fef9f0 100%); min-height: 100vh;">

    <nav class="app-nav">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">
            <div class="nav-brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 11l3 3L22 4"></path>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                </svg>
            </div>
            <span class="nav-brand-text">ToDoListApp</span>
        </a>

        <div class="nav-actions">
            <a asp-controller="Auth" asp-action="LogIn" class="btn-nav-ghost">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>Sign In</span>
            </a>
            <a asp-controller="Auth" asp-action="Register" class="btn-nav-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>Create Account</span>
            </a>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="footer-dot"></div>
        <span class="footer-brand">ToDoListApp</span>
        <div class="footer-dot"></div>
        <span class="footer-text">&copy; 2026 All rights reserved</span>
        <div class="footer-dot"></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
